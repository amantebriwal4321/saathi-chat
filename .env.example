# Public client key. Safe to expose. Singapore data center.
NEXT_PUBLIC_NEXCONN_APP_KEY=y745wfm8ynerv
NEXT_PUBLIC_NEXCONN_AREA=SG

# Server only. Set both in Vercel. Never commit the secret.
NEXCONN_APP_KEY=y745wfm8ynerv
NEXCONN_APP_SECRET=

# Optional. Defaults to the Singapore API.
NEXCONN_API_BASE=https://api.sg-light-api.com

# Video calls. Leave false until Audio/Video Calling is enabled in the console.
ENABLE_CALLS=false
NEXT_PUBLIC_ENABLE_CALLS=false

# Optional translation. If both are empty, Saathi uses MyMemory (no key).
GROQ_API_KEY=
GEMINI_API_KEY=
